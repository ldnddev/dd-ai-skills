/.playwright-mcp

# Node deps — regenerated via npm install
node_modules/

# Plugin SessionStart bootstrap sentinels (per-host state)
.dd-*-bootstrap.ok

# axe-core resolved from the npm latest tag at audit time
**/.axe-runtime/

# Python cache
__pycache__/
*.pyc
*.pyo

# Generated audit bundles (per-run client outputs)
web/

# Generated dd-blogs output (per-run blog directories)
/blog/

# Loose test/debug PNGs at repo root
/*.png

# Git worktrees (local isolation)
.worktrees/
